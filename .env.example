# Copiá este archivo a `.env` (ya está en .gitignore, no se sube al repo) y
# completá los valores reales.
#
# En Vercel: Project Settings → Environment Variables, cargar las mismas
# claves ahí para que funcionen también en producción.

# --- Google reCAPTCHA v3 (anti-spam del formulario post-compra) -----------
# Site key pública — se consigue en google.com/recaptcha/admin. La secret
# key NO va acá: se pega directo en el script de Google Apps Script
# (GOOGLE_APPS_SCRIPT.md), nunca en el frontend.
VITE_RECAPTCHA_SITE_KEY=

# --- Mercado Pago (Checkout Pro vía API) -----------------------------------
# NO lleva prefijo VITE_ a propósito: es secreto, solo lo usan las funciones
# serverless de /api, nunca el frontend. Ver MERCADOPAGO-SETUP.md.
# No hace falta en tu `.env` local si no vas a correr `vercel dev` — solo
# hace falta cargarlo en Vercel (Project Settings → Environment Variables).
MERCADOPAGO_ACCESS_TOKEN=

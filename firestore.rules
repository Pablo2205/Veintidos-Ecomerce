rules_version = '2';

// Reglas de seguridad de Firestore para veintidós.
//
// Por qué existe este archivo: Firestore, por defecto (modo "producción"
// cuando creás la base), deniega TODO acceso hasta que definís reglas
// explícitas — eso es lo correcto, nunca hay que arrancar en "modo test"
// (que permite leer/escribir a cualquiera, sin login, por 30 días) en un
// proyecto real.
//
// Cómo se aplica: pegá este archivo tal cual en Firebase Console →
// Firestore Database → Reglas → Publicar. (O con la Firebase CLI:
// `firebase deploy --only firestore:rules`, si en algún momento se suma
// esa herramienta al proyecto.)
//
// Única colección que usa el sitio hoy: `carts/{uid}` — el carrito
// guardado de cada usuario logueado (ver `CartContext.jsx`). La regla
// central es: cada usuario SOLO puede leer y escribir su propio documento
// (el que coincide con su propio uid de Firebase Auth) — nunca el de otro.
service cloud.firestore {
  match /databases/{database}/documents {
    match /carts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Además de "es el dueño", validamos la forma de los datos: `items`
      // tiene que ser una lista razonable (evita que alguien mande un
      // payload gigante o con un tipo de dato inesperado para llenar la
      // base o romper la lectura en el panel).
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.items is list
                   && request.resource.data.items.size() <= 50;
    }

    // Todo lo que no sea explícitamente permitido arriba queda denegado.
    // Si en el futuro se agrega otra colección, hay que sumar su propia
    // regla — nunca abrir esto a "allow read, write: if true".
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
